# AgriConnect Root Environment Variables Template

# Backend Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Production Frontend URL — set this to your Vercel URL in production
# Example: CLIENT_URL=https://agriconnect.vercel.app
CLIENT_URL=http://localhost:5173
